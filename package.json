{
  "name": "@matterwave/sdk",
  "version": "0.5.0",
  "description": "TypeScript client for the MatterWave API (the OpenAI-compatible /v1 surface)",
  "license": "MIT",
  "author": "MatterWave AI Contributors",
  "keywords": [
    "matterwave",
    "openai",
    "api",
    "client",
    "llm",
    "chat",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatterWaveAI/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/MatterWaveAI/typescript-sdk/issues"
  },
  "homepage": "https://github.com/MatterWaveAI/typescript-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent.d.ts",
        "default": "./dist/agent.js"
      },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "agent": [
        "./dist/agent.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "attw": "attw --pack .",
    "agent:check": "vitest run tests/agent-contract.test.ts",
    "openapi:refresh": "node scripts/refresh-openapi.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
