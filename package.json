{
  "name": "@matterwave/sdk",
  "version": "0.2.1",
  "description": "TypeScript client for the MatterWave API (the OpenAI-compatible /v1 surface)",
  "license": "MIT",
  "author": "MatterWave AI Contributors",
  "keywords": [
    "matterwave",
    "openai",
    "api",
    "client",
    "llm",
    "chat",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatterWaveAI/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/MatterWaveAI/typescript-sdk/issues"
  },
  "homepage": "https://github.com/MatterWaveAI/typescript-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
